# ==============================================================================
# The Taste-Evolving Concierge - Environment Configuration
# ==============================================================================
# Copy this file to .env and insert your API credentials.
# Do NOT commit your actual .env file to version control.

# Google Gemini AI (Required for live LLM reasoning and text embeddings)
# Obtain your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# Qloo Cultural Intelligence API (Required for cultural affinity bridging)
# Hackathon endpoint: https://hackathon.api.qloo.com
QLOO_API_KEY=your_qloo_api_key_here
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Qdrant Vector Database (Required for similarity search)
# Create a free cloud cluster at: https://cloud.qdrant.io/
QDRANT_URL=your_qdrant_cluster_url_here
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=fashion_clip_recommender

# Server Configuration
PORT=8000
HOST=0.0.0.0
